# Konfiguracja Kalendarza. Kopia: cp .env.example .env (compose czyta .env).
# Puste wartości = sensowne domyślne; w produkcji ustaw co najmniej SECRET_KEY, ALLOWED_HOSTS, CSRF.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=                     # python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=kalendarz.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://kalendarz.example.com
# za reverse proxy / tunelem TLS kończy się wcześniej — te dwie linie zawsze razem (inaczej pętla przekierowań)
DJANGO_SSL_REDIRECT=1
HTTP_PORT=127.0.0.1:8095               # port na hoście (tylko lokalnie; proxy/tunel sięga do niego)

# --- dane ---
DJANGO_DB_PATH=/data/db.sqlite3
DJANGO_MEDIA_ROOT=/data/media          # logo lokali

# --- instalacja ---
# jeden lokal: nazwa pliku z lokale/ (np. demo) — lokal i menu startowe założy się przy pierwszym starcie
# wspólna instancja: PUSTE (lokale zakłada logowanie przez Konto, firma = lokal)
KALENDARZ_LOKAL=demo
KALENDARZ_PUBLICZNY=0                  # 1 = strona publiczna z demo pod /
DEMO_MAX=0                             # demo bez logowania: 0 = wyłączone; wspólna instancja np. 200
DEMO_HOURS=24
DEMO_PER_HOUR=20
REGULAMIN_WYMAGANY=                    # puste = tyle, ile KALENDARZ_PUBLICZNY
GA_MEASUREMENT_ID=                     # G-XXXXXXXXXX = tag GA4 na stronie publicznej i regulaminie

# --- logowanie przez Konto sudomie (OIDC) ---
# puste OIDC_ISSUER = brak przycisku „Zaloguj przez …”, zostaje lokalne logowanie
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAZWA=Konto sudomie
KONTO_URL=https://konto.sudomie.pl/rejestracja/?produkt=kalendarz
# instalacja jednej firmy: uuid firmy z Konta (innych firm nie wpuszcza); wspólna: puste
KALENDARZ_FIRMA=

# --- API serwer–serwer (opcjonalne) ---
API_KLIENCI=
API_MAX_DNI=62
