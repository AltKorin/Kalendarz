# Konfiguracja Kalendarza. Kopia: cp .env.example .env
# Komentarz MUSI stać w osobnej linii — w plikach .env nie ma komentarzy w linii z wartością.
# Puste wartości = sensowne domyślne; w produkcji ustaw co najmniej SECRET_KEY, ALLOWED_HOSTS, CSRF.

# --- Django ---
DJANGO_DEBUG=0
# python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=kalendarz.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://kalendarz.example.com
# za reverse proxy / tunelem TLS kończy się wcześniej — przekierowanie i nagłówek X-Forwarded-Proto zawsze razem
DJANGO_SSL_REDIRECT=1
# port na hoście; proxy albo tunel sięga do niego, świat nie
HTTP_PORT=127.0.0.1:8095

# --- dane (w kontenerze na wolumenie /data) ---
DJANGO_DB_PATH=/data/db.sqlite3
DJANGO_MEDIA_ROOT=/data/media

# --- instalacja ---
# jeden lokal: nazwa pliku z lokale/ (np. demo) — lokal i menu startowe założą się przy pierwszym starcie
# wspólna instancja: puste — lokale zakłada logowanie przez Konto (firma = lokal)
KALENDARZ_LOKAL=demo
# 1 = strona publiczna z demo pod /
KALENDARZ_PUBLICZNY=0
# demo bez logowania: 0 = wyłączone; wspólna instancja np. 200
DEMO_MAX=0
DEMO_HOURS=24
DEMO_PER_HOUR=20
# puste = tyle, ile KALENDARZ_PUBLICZNY
REGULAMIN_WYMAGANY=
# 1 = rezerwacje stolików à la carte w panelu (zakładka Rezerwacje)
REZERWACJE_STOLIKOW=0
# 1 = rzut sali: układanie stolików i zajętość o wybranej godzinie (wymaga REZERWACJE_STOLIKOW=1)
RZUT_SALI=0
# G-XXXXXXXXXX = tag GA4 na stronie publicznej i regulaminie
GA_MEASUREMENT_ID=

# --- logowanie przez Konto sudomie (OIDC) ---
# puste OIDC_ISSUER = brak przycisku „Zaloguj przez …”, zostaje logowanie lokalne
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAZWA=Konto sudomie
KONTO_URL=https://konto.sudomie.pl/rejestracja/?produkt=kalendarz
# instalacja jednej firmy: uuid firmy z Konta (innych firm nie wpuszcza); wspólna instancja: puste
KALENDARZ_FIRMA=

# --- API serwer–serwer dla innych produktów (opcjonalne) ---
API_KLIENCI=
API_MAX_DNI=62
