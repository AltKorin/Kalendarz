DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-50-random-chars
DJANGO_ALLOWED_HOSTS=samiswoi.sudomie.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://samiswoi.sudomie.pl
# Instalacja jednego lokalu (samiswoi.sudomie.pl): lokal startowy z lokale/<id>.json, bez strony publicznej i demo
KALENDARZ_LOKAL=sami-swoi
KALENDARZ_PUBLICZNY=0
DEMO_MAX=0
# Wspólna instancja (kalendarz.sudomie.pl) — zamiast trzech linii wyżej:
#   KALENDARZ_LOKAL=            (puste: lokale zakłada logowanie przez Konto, firma = lokal)
#   KALENDARZ_PUBLICZNY=1       (strona z opisem i demo pod /)
#   DEMO_MAX=200  DEMO_HOURS=24  DEMO_PER_HOUR=20
#   KALENDARZ_FIRMA=            (puste: wpuszcza każdą firmę z dostępem do Kalendarza w Koncie)
# za tunelem Cloudflare: SSL kończy się na proxy; SECURE_PROXY_SSL_HEADER jest ustawiany razem z redirectem
DJANGO_SSL_REDIRECT=1
HTTP_PORT=127.0.0.1:8095
# GA4 (tylko strona startowa i regulamin, po zgodzie w banerze). Puste = brak tagu. Własna usługa GA4 dla kalendarz.sudomie.pl.
GA_MEASUREMENT_ID=
# Akceptacja regulaminu przez kierownika lokalu (domyślnie = KALENDARZ_PUBLICZNY)
# REGULAMIN_WYMAGANY=1
